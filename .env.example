# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Production: inject these from a secret manager (e.g. AWS Secrets Manager / GCP Secret Manager /
# Vault / Doppler) as environment variables instead of a file.

# --- Broker (Kite Connect app: https://developers.kite.trade/apps) ---
# Set the app's Redirect URL to: http://127.0.0.1:8000/auth/callback
BROKER_API_KEY=your_api_key
BROKER_API_SECRET=your_api_secret
# Optional: a pre-generated access token (otherwise log in from the dashboard each day)
ACCESS_TOKEN=

# --- Mode & safety ---
TRADING_MODE=paper              # paper | live
LIVE_TRADING_ENABLED=false      # must be true AND TRADING_MODE=live AND armed in the UI to send real orders
LIVE_MAX_ORDER_LOTS=1           # hard cap on lots per live order
FEED_SOURCE=kite                # kite | synthetic (synthetic = simulated session, paper only)
SYNTHETIC_SPEED=10              # synthetic session speed multiplier

# --- Risk limits (override config/trading.yaml) ---
DEFAULT_CAPITAL=500000
MAX_DAILY_LOSS=15000
MAX_RISK_PER_TRADE=5000
MAX_TRADES_PER_DAY=5
MAX_OPEN_POSITIONS=3
DEFAULT_TIMEFRAME=5m

# --- Paths / URLs ---
TRADING_CONFIG=config/trading.yaml
DB_PATH=data/trading.db
LOG_DIR=logs
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:8501
